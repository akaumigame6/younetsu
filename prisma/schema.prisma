// このファイルを更新したら...
// 0. `npm run dev` や `npx prisma studio` を停止
// 1. dev.db を削除
// 2. npx prisma db push
// 3. npx prisma generate
// 4. npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}



// ========================
// Exhibit (小枠: 作家・作品など)
// ========================
model Exhibit {
  id          String  @id @default(uuid())
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  shareToken  String  @unique @default(cuid())
  iconUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedbackRecords ExhibitFeedback[]
}

// ========================
// ExhibitFeedback (小枠への感想)
// ========================
model ExhibitFeedback {
  id        String  @id @default(uuid())
  exhibitId String
  exhibit   Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  viewerId  String?

  inputType        String   // "free" または "questions"
  content          String
  q1               String   // SQLite非対応のためString(JSON)に変更
  q2               String?
  q3               String?

  eventFeedbackId String?
  eventFeedback   EventFeedback? @relation(fields: [eventFeedbackId], references: [id], onDelete: SetNull)

  reaction  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================
// EventFeedback (大枠イベント全体への感想)
// ========================
model EventFeedback {
  id      String @id @default(uuid())
  eventId String 
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  viewerId  String?

  inputType        String // "free" または "questions"
  content          String
  q1               String // SQLite非対応のためString(JSON)に変更
  q2               String?
  q3               String?
  referralSources  String // SQLite非対応のためString(JSON)に変更
  customAnswers    String? // JSON文字列としてカスタム質問への回答を保存
  isRead           Boolean  @default(false) // 既読フラグ

  exhibitFeedbacks ExhibitFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================
// Event (大枠: イベント)
// ========================
model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  location    String?

  // 質問プレースホルダー
  eventQ2Placeholder     String?
  eventQ3Placeholder     String?
  creatorQ2Placeholder   String?
  creatorQ3Placeholder   String?
  freeEventPlaceholder   String?
  freeCreatorPlaceholder String?

  // 「何でイベントを知ったか」の選択肢 (カンマ区切りなどで保存)
  referralSources        String?

  // 主催者ID (SupabaseのユーザーIDなど)
  adminId                String

  // イベントの設定
  eventType              String   @default("group") // "solo" または "group" 等
  hasExhibits            Boolean  @default(true)
  exhibitTerm            String   @default("作家")
  
  hasEventSurvey         Boolean  @default(true) // イベント全体感想(大枠)を集めるか
  customQuestions        String?  // JSON文字列としてカスタム質問を保存
  
  useReadStatus          Boolean  @default(true) // 既読機能を使用するかどうか

  eventFeedbacks EventFeedback[]
  exhibits       Exhibit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

